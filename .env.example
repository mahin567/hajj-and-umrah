# Copy to .env and edit:  cp .env.example .env
# Real environment variables (set on your host) override this file. Never commit .env.

# --- Local development: uncomment this one line and you can ignore the rest ---
DJANGO_DEBUG=1

# --- Production: remove DJANGO_DEBUG above, then uncomment and fill these in ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://your-site.vercel.app
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# PostgreSQL recommended. Leave empty to use the local SQLite file.
# DATABASE_URL=
# Hide the Django admin at a less guessable address, e.g. office-panel/
# ADMIN_URL=admin/

# --- Email alerts to staff for every new enquiry / appointment / review ---
# STAFF_NOTIFY_EMAILS=office@example.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Own The World <no-reply@example.com>

# --- Tuning (defaults shown) ---
# NUM_PROXIES=1
# ADMIN_TOKEN_TTL_HOURS=12
# THROTTLE_PUBLIC_FORM=10/hour
# THROTTLE_ADMIN_LOGIN=10/min
# BOOKING_MAX_DAYS_AHEAD=120
# BOOKING_MIN_NOTICE_MINUTES=30
